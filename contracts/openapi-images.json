              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health"
      }
    },
    "/api/images": {
      "get": {
        "description": "Фильтры category/tag комбинируются; пустые — все; created_at DESC.",
        "operationId": "list_images_api_images_get",
        "parameters": [
          {
            "in": "query",
            "name": "category",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Category"
            }
          },
          {
            "in": "query",
            "name": "tag",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Tag"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "unauthorized (без валидной сессии — middleware)"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "List Images"
      },
      "post": {
        "description": "multipart: file, category? (id | новое имя), tags? («a,b» | повторяемое).\n\nВалидация типа (magic-байты) и размера (≤10 МБ) — ДО записи файлов в том:\nпри 422 файлы не создаются (scenario «Негативный: превышение размера»).\nМетаданные + связи (категория/теги) — одна транзакция.",
        "operationId": "upload_image_api_images_post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_upload_image_api_images_post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "unauthorized (без валидной сессии — middleware)"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "две формы: {\"error\", \"details\"} (битый multipart/файл — validation-handler) и {\"detail\": \"invalid file: unknown category\"} (семантическая — HTTPException)"
          }
        },
        "summary": "Upload Image"
      }
    },
