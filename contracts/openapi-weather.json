  "paths": {
    "/api/health": {
      "get": {
        "description": "Health-check (exempt middleware; без БД и без провайдера —\nhealth 200 и на пустом томе кэша; design §6).",
        "operationId": "health_api_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Health Api Health Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health"
      }
    },
    "/api/weather": {
      "get": {
        "description": "API погоды (контракт design §6; сессия проверена middleware).\n\nБез аннотации ответа: успешная ветка возвращает dict (контракт §6),\nдеградация — JSONResponse 503; Union-аннотация не валидируется\nPydantic'ом как response_model (и не нужна — контракт фиксируют тесты).",
        "operationId": "get_weather_api_weather_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WeatherResponse"
                }
              }
            },
            "description": "Карточка погоды: fetched_at + stale + today («Сегодня») + days (ровно 7 дней, включая сегодня); числовые метрики могут быть null (деградация «—» во фронтенде)"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "unauthorized (без валидной сессии — middleware)"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "деградация: нет кэша И провайдер недоступен — {\"error\": \"weather_unavailable\"}, заголовок Retry-After: 60"
          }
        },
        "summary": "Get Weather"
      }
    }
  }
