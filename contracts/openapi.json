    "/api/profile/avatar": {
      "post": {
        "description": "Загрузка и серверное автосжатие аватара пользователя сессии.\n\nСюда попадают только запросы с действующей сессией (middleware;\nэндпоинт вне exempt-списка, NFR-7). Пользователь — только из сессии\n(свой аватар, FR-39/FR-42); имя файла генерирует сервер.",
        "operationId": "upload_avatar_api_profile_avatar_post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_upload_avatar_api_profile_avatar_post"
              }
