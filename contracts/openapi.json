    "/api/search": {
      "get": {
        "deprecated": true,
        "description": "GET /api/search — структурированные условия (sdd §3.5, FR-10/11/8).\n\nВалидация типов/значений — FastAPI/pydantic: невалидный priority,\nдата не формата YYYY-MM-DD, archived вне true|false|all → 422\n(обработчик RequestValidationError, sdd §3). 401 без сессии —\nmiddleware. Пустой набор параметров = все задачи.\nРелиз 4 (FR-46, ОВ-24): assigned = login | none («без исполнителя»),\ncreator = login; несуществующий логин → 422 (5.2, «422 на\nневозможное значение»).\n\nПереезд в search-сервис (пакет add-microservices-full)",
        "operationId": "search_api_search_get",
        "parameters": [
          {
            "in": "query",
            "name": "priority",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "enum": [
                    "low",
                    "medium",
                    "high"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Priority"
            }
          },
          {
            "in": "query",
            "name": "category",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Category"
            }
          },
          {
            "in": "query",
            "name": "tag",
            "required": false,
            "schema": {
              "items": {
                "type": "string"
              },
              "title": "Tag",
              "type": "array"
            }
          },
          {
            "in": "query",
            "name": "due_before",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "date",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Due Before"
            }
          },
          {
            "in": "query",
            "name": "due_after",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "date",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Due After"
            }
          },
          {
            "in": "query",
            "name": "archived",
            "required": false,
            "schema": {
              "default": "all",
              "enum": [
                "true",
                "false",
                "all"
              ],
              "title": "Archived",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "assigned",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
