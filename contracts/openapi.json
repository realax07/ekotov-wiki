                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Upload Avatar"
      }
    },
    "/api/profile/password": {
      "post": {
        "description": "Смена пароля (FR-41, Д-11; sdd §3.1a-кватер).\n\n422 при неверном текущем пароле (пароль не меняется) или пустом новом;\n200 {\"ok\": true} — sessions не трогаются (текущая сессия живет, Д-11).",
        "operationId": "change_password_api_profile_password_post",
