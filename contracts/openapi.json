  "paths": {
    "/api/auth/login": {
      "post": {
        "description": "Вход (sdd.md §3.1). 200 + кука сессии; 401 — единый текст ошибки.",
        "operationId": "login_api_auth_login_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Login"
      }
    },
    "/api/auth/logout": {
      "post": {
        "description": "Выход (tasks.md 2.2; sdd.md r4 §3.1): удаляет сессию и куку.\n\nДоступен только с валидной сессией — exempt-списком не покрыт, путь\nпроходит через middleware (app/middleware.py); сюда попадают только\nзапросы с действующей сессией.",
        "operationId": "logout_api_auth_logout_post",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Logout"
      }
    },
    "/api/auth/me": {
      "get": {
        "description": "Текущий пользователь (sdd.md §3.1-бис + §3.1a-кватер, tasks.md 2.1\nРелиза 4 — расширение состава профилем; change\nadd-r4-user-profile-ticket-view, FR-33/36/43).\n\nСюда попадают только запросы, прошедшие middleware с действующей\nсессией (эндпоинт вне exempt-списка, NFR-7). JOIN sessions→users по\nтокену куки (З-1 ревью-001). Ответ расширен составом профиля:\n{\"user\", \"display_name\", \"role\", \"bio\", \"avatar_url\"}; при незаполненном\nпрофиле поля профиля — null, ключ \"user\" (логин) сохранен всегда —\nобратная совместимость с profile.js (sdd §3.1a-кватер).\nRead-only: никаких INSERT/UPDATE/DELETE.",
        "operationId": "me_api_auth_me_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Me"
      }
    },
    "/api/board": {
      "get": {
        "description": "Столбцы доски (sdd r5 §3.3): 200; без сессии — 401 (middleware).\n\nРелиз 4 (sdd r10 §3.2, ОВ-24): задачи содержат creator и assigned —\nлогины (LEFT JOIN users).",
        "operationId": "get_board_api_board_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Get Board"
      }
    },
    "/api/categories": {
      "get": {
        "description": "GET /api/categories → 200 {\"categories\": [...]} по name (sdd r2 §3.1).",
        "operationId": "list_categories_api_categories_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "List Categories"
      },
      "post": {
        "description": "Создать категорию (design.md §1.4): 201; 422 пустое имя; 409 дубль.\n\nПроверка на непустое имя — после trim (pydantic-валидатор); уникальность —\nна уровне БД (UNIQUE name, design.md §1.1): IntegrityError → 409.",
        "operationId": "create_category_api_categories_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CategoryCreate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Create Category"
      }
    },
    "/api/categories/{category_id}": {
      "delete": {
        "description": "Удалить (Д-1): 200 {\"ok\": true}; 404; 409 если используется задачами.\n\nПорядок — design.md §1.4: проверить использование\n(SELECT COUNT(*) FROM tasks WHERE category = ?) → удалить; использующие\nзадачи получают отказ с их числом (перевести задачи → удалить). Гонка с\nпараллельной установкой категории закрыта серверной валидацией FR-21\n(design.md §1.4): задача с уже удаленной категорией не сохранится.",
        "operationId": "delete_category_api_categories__category_id__delete",
        "parameters": [
          {
            "in": "path",
            "name": "category_id",
            "required": true,
            "schema": {
              "title": "Category Id",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Delete Category"
      },
      "patch": {
        "description": "Переименовать (design.md §1.4): 200; 404; 422 пустое имя; 409 дубль.\n\nЗадачи ссылаются по значению (tasks.category = TEXT), поэтому один\nатомарный UPDATE categories.name автоматически меняет категорию у всех\nзадач-ссылок — наблюдаемое «применяется ко всем задачам» (FR-20,\ndesign.md §1.1).",
        "operationId": "rename_category_api_categories__category_id__patch",
        "parameters": [
          {
            "in": "path",
            "name": "category_id",
            "required": true,
            "schema": {
              "title": "Category Id",
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CategoryUpdate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Rename Category"
      }
    },
    "/api/health": {
      "get": {
        "description": "Health-check каркаса (дополнение к sdd.md §3 — см. отчет задачи 1.1).",
