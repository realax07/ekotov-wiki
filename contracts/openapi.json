    "/api/profile": {
      "get": {
        "description": "Профиль пользователя сессии (FR-36, FR-40; sdd §3.1a-кватер).",
        "operationId": "get_profile_api_profile_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
