    "/api/videos": {
      "get": {
        "description": "Список: имя, статус, размер, дата + playback/preview URL.\n\nКусок D: фильтр ?category=<id|none> (none = «Без категории»,\ncategory_id IS NULL; неверный id — 422); в элементах — category_id/\ncategory_name (COALESCE имени справочника галереи), likes/dislikes/\nmy_reaction (агрегаты video_reactions; мой голос — по сессии).\npreview_url — API-эндпоинт (409 = плейсхолдер по макету);\nfile_url — nginx-отдача из тома /videos/<id>/… (design §5,\nauth_request-сессия, Range для <video>).\n\nКусок C (4.1): ?query=<подстрока>&order=asc|desc (sdd §3) — поиск по\nподстроке имени БЕЗ учета регистра (lower()-нормализация обеих сторон\nLIKE; lower перекрыт на unicode — кириллица, см. db.py) и сортировка\nпо имени в обе стороны (lower(filename); встроенный COLLATE NOCASE\nASCII-only — кириллицу не складывает, поэтому тот же unicode-lower).\nКомбинируется с фильтром категории (И всех активных условий);\nпустой/отсутствующий query — все видео. %/_ в query — обычные\nсимволы (ESCAPE ''). order не указан — прежний порядок свежие-сверху\n(created_at DESC); неверный order — 422.",
        "operationId": "list_videos_api_videos_get",
        "parameters": [
          {
            "in": "query",
            "name": "category",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Category"
            }
          },
          {
            "in": "query",
            "name": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Query"
            }
          },
          {
            "in": "query",
            "name": "order",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Order"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "unauthorized (без валидной сессии — middleware)"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "List Videos"
      },
      "post": {
        "description": "multipart: file (любой формат, ≤ 500 МБ, ОВ-1/ОВ-4) + опц.\ncategory_id (кусок D; валидация существования в image_categories —\nиначе 422; NULL = «Без категории»).\n\nЛимит проверяется ДО записи в том: pre-check по Content-Length +\nпотоковый счетчик (диск под файл расходуется только под temp вне\nтома и только в пределах лимита; при отказе — чистится). Scenario\n«Отказ при превышении лимита»: 422, файл не сохранен, записи нет.",
        "operationId": "upload_video_api_videos_post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_upload_video_api_videos_post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "unauthorized (без валидной сессии — middleware)"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "validation error: {\"error\", \"details\"} (handler RequestValidationError); семантические отказы загрузки (лимит 500 МБ, unknown category) — та же форма"
          }
        },
        "summary": "Upload Video"
      }
    },
    "/api/videos/authcheck": {
      "get": {
        "description": "200 {} при валидной сессии / 401 — по cookie subrequest'а.\n\nВызывается nginx'ом на каждый запрос /videos/*: только SELECT\nsessions (O(мс)), никаких чтений video_videos (sdd §3 «без чтения\nБД тяжелее проверки сессии»).\n\ninternal: потребитель — nginx auth_request (стык /_video_auth), не браузер",
        "operationId": "authcheck_api_videos_authcheck_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "невалидная сессия: {\"error\": \"unauthorized\"} (решает сам эндпоинт)"
          }
        },
        "summary": "Authcheck"
      }
    },
