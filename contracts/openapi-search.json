{
  "components": {
    "schemas": {
      "Error": {
        "properties": {
          "error": {
            "type": "string"
          }
        },
        "required": [
          "error"
        ],
        "type": "object"
      }
    }
  },
  "info": {
    "title": "ekotov-wiki",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/health": {
      "get": {
        "description": "Health-check сервиса (exempt-список middleware — монитор/deploy до входа).",
        "operationId": "health_api_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Health Api Health Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health"
      }
    },
    "/api/search": {
      "get": {
        "description": "GET /api/search — структурированные условия (sdd §3.5, FR-10/11/8).\n\nВалидация типов/значений — FastAPI/pydantic: невалидный priority,\nдата не формата YYYY-MM-DD, archived вне true|false|all → 422\n(обработчик RequestValidationError, sdd §3). 401 без сессии —\nmiddleware. Пустой набор параметров = все задачи.\nРелиз 4 (FR-46, ОВ-24): assigned = login | none («без исполнителя»),\ncreator = login; несуществующий логин → 422 (5.2, «422 на\nневозможное значение»).",
        "operationId": "search_api_search_get",
        "parameters": [
          {
            "in": "query",
            "name": "priority",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "enum": [
                    "low",
                    "medium",
                    "high"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Priority"
            }
          },
          {
            "in": "query",
            "name": "category",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Category"
            }
          },
          {
            "in": "query",
            "name": "tag",
            "required": false,
            "schema": {
              "items": {
                "type": "string"
              },
              "title": "Tag",
              "type": "array"
            }
          },
          {
            "in": "query",
            "name": "due_before",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "date",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Due Before"
            }
          },
          {
            "in": "query",
            "name": "due_after",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "date",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Due After"
            }
          },
          {
            "in": "query",
            "name": "archived",
            "required": false,
            "schema": {
              "default": "all",
              "enum": [
                "true",
                "false",
                "all"
              ],
              "title": "Archived",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "assigned",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Assigned"
            }
          },
          {
            "in": "query",
            "name": "creator",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Creator"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "unauthorized (без валидной сессии — middleware)"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "validation error: {\"error\", \"details\"} (handler RequestValidationError: невалидные query-параметры; несуществующий assigned/creator — та же форма, search.py _validate_user_logins)"
          }
        },
        "summary": "Search"
      }
    },
    "/api/search/advanced": {
      "post": {
        "description": "POST /api/search/advanced (sdd.md §3.5; FR-12).\n\nТело: {\"query\": \"<SQL-подобный текст фильтра>\"}.\n- 200: {\"results\": [Task], \"normalized_query\": build(фильтра)}.\n- 400 {\"error\": \"filter syntax: position N: причина\"} — синтаксическая\n  ошибка; запрос к БД не выполняется (parse до get_connection).\n  Невалидное JSON-тело тоже 400 (формат ошибок этого эндпоинта,\n  sdd §3.5), не 500: битый JSON = нечитаемый фильтр.\n- 401 без сессии — middleware.\n- 422 (тело читается, но query — не строка) — обработчик sdd §3.",
        "operationId": "search_advanced_api_search_advanced_post",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "filter syntax error: {\"error\": \"filter syntax: position N: причина\"} (синтаксическая ошибка — запрос к БД не выполняется) или {\"error\": \"filter syntax: invalid JSON body\"} (невалидное тело; endpoint-форма, sdd §3.5)"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "unauthorized (без валидной сессии — middleware)"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "validation error: {\"error\", \"details\"} (тело читается, но query — не строка)"
          }
        },
        "summary": "Search Advanced"
      }
    },
    "/api/suggestions": {
      "get": {
        "description": "GET /api/suggestions → {\"suggestions\": [str, ...]} (см. docstring модуля).\n\nkind (Релиз 6, FR-57/ОГР-26): None — прежний UNION тегов и категорий\n(обратная совместимость); \"tags\" — только теги; \"categories\" — только\nкатегории. Иное значение — 422 средствами FastAPI (Literal), явный\nотказ без ответа с множеством.",
        "operationId": "suggestions_api_suggestions_get",
        "parameters": [
          {
            "in": "query",
            "name": "kind",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "enum": [
                    "tags",
                    "categories"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Kind"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Suggestions Api Suggestions Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "unauthorized (без валидной сессии — middleware)"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "validation error: {\"error\", \"details\"} (kind вне tags/categories — handler RequestValidationError)"
          }
        },
        "summary": "Suggestions"
      }
    },
    "/api/suggestions/users": {
      "get": {
        "description": "GET /api/suggestions/users → {\"users\": [login, ...]} (5.2, FR-46).\n\nУникальные логины из tasks.creator_id ∪ tasks.assigned_to_id (JOIN\ntasks→users), отсортированы. 401 без сессии — middleware (путь не в\nexempt-списке). Потребитель: опции select'ов «Исполнитель»/\n«Создатель» конструктора поиска (search.js); опцию «без исполнителя»\nдобавляет клиент (статическая, ОВ-24).",
        "operationId": "user_suggestions_api_suggestions_users_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response User Suggestions Api Suggestions Users Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "unauthorized (без валидной сессии — middleware)"
          }
        },
        "summary": "User Suggestions"
      }
    }
  }
}
