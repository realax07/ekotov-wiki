# Переменные окружения ekotov-wiki.
# Скопируйте в .env (в .gitignore, в репозиторий не попадает) и заполните:
#   cp .env.example .env
# Запуск локально: uvicorn app.main:app --env-file .env (из backend/)
# Развертывание: systemd EnvironmentFile (задача 1.4, deploy/)

# Путь к файлу SQLite. Вне репозитория (NFR-5). Пример: /var/lib/ekotov-wiki/wiki.db
DB_PATH=

# Секретный ключ приложения (сессии). Сгенерируйте: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
